<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tempo</AssemblyName>
    <RootNamespace>AutoClicker</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tempo.ico</ApplicationIcon>
    <Version>1.0.115</Version>
    <AssemblyVersion>1.0.115.0</AssemblyVersion>
    <FileVersion>1.0.115.0</FileVersion>
    <Company>Tempo Project</Company>
    <Product>Tempo</Product>
    <AssemblyTitle>Tempo</AssemblyTitle>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Description>A full-featured mouse auto-clicker with profiles, multi-point clicking, macro recording, randomization and statistics.</Description>

    <!-- Keep only English resources so a published build stays a single clean file. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Supported runtime identifiers for `dotnet publish -r ...`. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Publish defaults. These only take effect during `dotnet publish` for a
    specific runtime (RuntimeIdentifier is set) so a normal Debug/Release build
    is unaffected. The result is a single self-contained Tempo.exe that bundles
    the .NET 8 runtime, so end users do NOT need to install anything by hand.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Keep trimming off: WinForms + reflection-heavy JSON don't trim safely. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- Embed the app icon so the window and tray can load it at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tempo.ico" />
    <EmbeddedResource Include="Assets\tempo-about.gif" />
  </ItemGroup>


</Project>
