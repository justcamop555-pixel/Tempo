<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows-SDK-versioned TFM (not plain net10.0-windows): the caption feature's
      face-and-mouth speaker analysis uses the OS's built-in on-device face
      detector (Windows.Media.FaceAnalysis.FaceDetector), which is only reachable
      through the WinRT projections this TFM brings in. Runs on Win10 1809+.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      UseWPF is required even though Tempo's UI is pure Windows Forms: the Windows Live
      Captions reader (Utils/LiveCaptionReader.cs) uses System.Windows.Automation (UI
      Automation), whose assemblies (UIAutomationClient / UIAutomationTypes) ship as part
      of the WPF half of the Windows Desktop framework. Removing UseWPF makes that file
      fail to compile and the whole build produces nothing. Do not remove it.
    -->
    <UseWPF>true</UseWPF>
    <AssemblyName>Tempo</AssemblyName>
    <RootNamespace>AutoClicker</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion><!-- Kept at C# 12 on .NET 10 on purpose: C# 14 changes which overload some span/array calls bind to (e.g. arr.Reverse() becomes an in-place reverse). Move it up as its own reviewed change, not as a side effect of the runtime. -->
    <!--
      WFO1000 (new in .NET 9, an error by default) asks every public property of a custom
      control to declare how the WinForms DESIGNER should write it into InitializeComponent.
      Tempo has no designer files - every screen is built in code - so nothing is ever
      designer-serialized and the rule has nothing to protect; on the move to .NET 10 it
      only produced 117 build errors across the custom controls.
    -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tempo.ico</ApplicationIcon>
    <Version>1.0.328</Version>
    <AssemblyVersion>1.0.328.0</AssemblyVersion>
    <FileVersion>1.0.328.0</FileVersion>
    <Company>Tempo Project</Company>
    <Product>Tempo</Product>
    <AssemblyTitle>Tempo</AssemblyTitle>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Description>A full-featured mouse auto-clicker with profiles, multi-point clicking, macro recording, randomization and statistics.</Description>

    <!-- Keep only English resources so a published build stays a single clean file. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Supported runtime identifiers for `dotnet publish -r ...`. -->
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Publish defaults (only active during `dotnet publish` for a specific runtime).
    Tempo publishes as ONE fully self-contained Tempo.exe that works ANYWHERE - moved
    or copied on its own, with no loose DLLs required next to it. Everything is bundled:
    the managed app, its config, the .NET runtime, the WPF/UI-Automation assemblies
    (UIAutomationClient etc. - needed by the Windows Live Captions reader), AND the
    native speech-engine libraries (whisper / ggml / NAudio). At startup the single-file
    host self-extracts native libs to a temp dir and adds it to the native search path,
    so they load correctly even though the .exe is by itself.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!--
      Bundle the native libraries (whisper.dll / ggml / NAudio natives) INTO the
      single-file exe and let the host self-extract them at run time. This is what makes
      Tempo.exe portable: previously these sat loose next to the exe, so moving the exe
      alone broke the app (and broke UI Automation loading, which looked like the
      CacheRequest failure). Bundling them removes that whole class of "only works inside
      its folder" problems.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      ReadyToRun: precompile IL to native so start-up doesn't JIT the world.

      THIS LIVES HERE, NOT ON THE COMMAND LINE. It used to be the one publish flag
      that wasn't in this file, so it had to be remembered every time — and it was
      forgotten for three releases running (1.0.314, .315 and .316 all shipped
      without it). Nothing fails when it is missing: you get a working exe that is
      ~17 MB smaller and slower to start, and the only visible symptom is the file
      size, which nobody checks on a good day.

      It also costs REAL time to forget. Measured on this machine:

        clean publish, R2R on ........ 65.1 s   (105,934,765 bytes)
        clean publish, R2R off ....... 15.4 s   ( 88,018,545 bytes)
        repeat publish, same flags .... 2.6 s   (fully cached)
        repeat publish, flags CHANGED  76.6 s   (cache thrown away)

      That last row is the point. Crossgen caches on the exact property set, so a
      publish that varies its flags re-runs the whole 65 s compile. Forgetting the
      flag once therefore cost a wasted 15 s run PLUS a 76 s redo — where keeping
      every invocation identical costs 2.6 s. Declaring it here is what makes the
      invocations identical, so it is both the correctness fix and the speed fix.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!--
      NOT composite. The SDK turns composite ReadyToRun ON by itself for every single-file
      publish since .NET 7 (Microsoft.NET.CrossGen.targets), and composite REWRITES the whole
      framework: all ~250 runtime DLLs came out as unsigned IL stubs beside one unsigned
      139 MB Tempo.r2r.dll, with hashes no PC had ever seen. Every first start unpacks them to
      %TEMP%\.net, and antivirus scans and cloud-checks each unknown unsigned file — users
      who downloaded Tempo.exe waited 1-2 minutes with nothing on screen (reported 2026-11-10).
      Off, the runtime ships as Microsoft built and SIGNED it (already precompiled by
      Microsoft), and only Tempo.dll is compiled here.
    -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <!--
    For the same reason, Microsoft's own SIGNED libraries that Tempo brings along are not
    recompiled: compiling them rewrites them, and the signature goes. The Windows SDK
    projection alone came out as a 52.8 MB unsigned file (Microsoft's signed original is
    23.7 MB). None of them runs at start-up — the WinRT accent read only with "Match
    Windows", WebView2 only for the experimental web settings page — so a few methods
    compile on first use instead, once.
  -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll;WinRT.Runtime.dll;Microsoft.Web.WebView2.Core.dll;Microsoft.Web.WebView2.WinForms.dll;Microsoft.Web.WebView2.Wpf.dll" />
  </ItemGroup>

  <!--
    Whisper.net's runtime packages add EVERY platform's native libraries to the output,
    whatever the target: a win-x64 Tempo.exe carried the Linux Vulkan build
    (libggml-vulkan-whisper.so, 20.6 MB) and the win-x86 and win-arm64 CPU builds — 24 MB
    unpacked on every first start, for nothing. On x64 Windows Whisper.net loads only
    runtimes\win-x64 and runtimes\vulkan\win-x64. Left out of the published bundle here
    (only for win-x64, the RID that ships).
  -->
  <Target Name="DropOtherPlatformNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <ItemGroup>
      <_TempoOtherPlatform Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(?i)^runtimes[\\/](vulkan[\\/])?(linux|osx|android|ios|tvos|maccatalyst|browser|win-x86|win-arm64)'))" />
      <ResolvedFileToPublish Remove="@(_TempoOtherPlatform)" />
    </ItemGroup>
    <Message Importance="high" Text="  Left out of the bundle (other platforms' native libraries): @(_TempoOtherPlatform->Count()) file(s)." />
  </Target>

  <!--
    Utils\BuildInfo.Generated.cs carries the build number and is git-ignored, because it
    changes on every publish and a file that churns on every build has no place in
    history. publish.cmd writes it via stamp-build.ps1; this target covers the case
    nobody remembers — a fresh clone, or someone running "dotnet build" without ever
    publishing — where the file simply is not there and the compiler would fail on the
    missing half of a partial class.

    Only when MISSING. Rewriting it every build would erase the stamped ID, which is the
    one thing it exists to carry. An empty stamp reports as "unstamped dev build":
    honest, and better than inventing an ID.
  -->
  <Target Name="EnsureBuildInfo" BeforeTargets="BeforeCompile" Condition="!Exists('$(MSBuildProjectDirectory)\Utils\BuildInfo.Generated.cs')">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Utils\BuildInfo.Generated.cs" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// GENERATED because it was missing - do not hand-edit, and do not commit.;// stamp-build.ps1 rewrites this on every publish. Logic lives in BuildInfo.cs.;namespace AutoClicker.Utils;{;    public static partial class BuildInfo;    {;        public const string StampUtc = &quot;&quot;%3B;        public const string Channel = &quot;dev&quot;%3B;    };}" />
    <Message Importance="high" Text="EnsureBuildInfo: wrote a neutral Utils\BuildInfo.Generated.cs (unstamped dev build)." />
  </Target>

  <!--
    A publish that quietly lost ReadyToRun is the failure this project has actually
    shipped, three times (1.0.314-.316). It used to be caught by the exe's SIZE, a 95 MB
    floor: with composite ReadyToRun the precompiled code was ~17 MB of it. Composite is
    off now (PublishReadyToRunComposite above), and then the runtime arrives precompiled
    by Microsoft either way — only Tempo.dll's own native code (~5 MB) hangs on this
    flag, too little for any size to tell. So the check asks the very Tempo.dll this
    publish bundles: a ReadyToRun image carries a native header (IMAGE_COR20_HEADER.
    ManagedNativeHeader), an IL-only one has none. Read by hand from the PE headers,
    so the inline task needs nothing beyond System.IO.
  -->
  <UsingTask TaskName="TempoIsReadyToRun" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
      <Compiled ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (FileStream s = File.OpenRead(AssemblyPath))
        using (BinaryReader r = new BinaryReader(s))
        {
            s.Position = 0x3C;
            int pe = r.ReadInt32();                       // "PE\0\0", then the COFF header
            s.Position = pe + 6;
            int sections = r.ReadUInt16();
            s.Position = pe + 20;
            int optionalSize = r.ReadUInt16();
            int optional = pe + 24;
            s.Position = optional;
            int magic = r.ReadUInt16();                   // 0x20B = PE32+, else PE32
            s.Position = optional + (magic == 0x20B ? 112 : 96) + 14 * 8;   // data directory 14: the CLI header
            uint cliRva = r.ReadUInt32();
            long cli = -1;
            for (int i = 0; i < sections && cli < 0; i++)
            {
                s.Position = optional + optionalSize + i * 40 + 8;
                uint virtualSize = r.ReadUInt32(), virtualAddress = r.ReadUInt32();
                uint rawSize = r.ReadUInt32(), rawPointer = r.ReadUInt32();
                if (cliRva >= virtualAddress && cliRva < virtualAddress + Math.Max(virtualSize, rawSize))
                {
                    cli = (long)cliRva - virtualAddress + rawPointer;
                }
            }
            Compiled = false;
            if (cli >= 0)
            {
                s.Position = cli + 64 + 4;                // IMAGE_COR20_HEADER.ManagedNativeHeader.Size
                Compiled = r.ReadUInt32() > 0;
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Just before the bundle is put together: by the end of a single-file publish the bundled
       files are no longer listed, and by here ReadyToRun (CreateReadyToRunImages) has swapped
       each compiled assembly's entry for its image. -->
  <Target Name="VerifyReadyToRun" BeforeTargets="_ComputeFilesToBundle" Condition="'$(RuntimeIdentifier)' != '' And '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_TempoBundledMain Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(AssemblyName).dll'" />
    </ItemGroup>
    <Error Condition="'@(_TempoBundledMain)' == ''" Text="Could not find $(AssemblyName).dll among the files to bundle, to verify ReadyToRun." />
    <TempoIsReadyToRun AssemblyPath="%(_TempoBundledMain.FullPath)">
      <Output TaskParameter="Compiled" PropertyName="_TempoMainIsR2R" />
    </TempoIsReadyToRun>
    <Error Condition="'$(_TempoMainIsR2R)' != 'True'" Text="ReadyToRun did NOT apply: the $(AssemblyName).dll bundled into $(AssemblyName).exe has no precompiled code, so every start JIT-compiles all of Tempo. PublishReadyToRun is set in AutoClicker.csproj; check nothing on the command line overrode it to false." />
    <Message Importance="high" Text="  ReadyToRun verified: the bundled $(AssemblyName).dll is precompiled." />
  </Target>

  <!-- Embed the app icon so the window and tray can load it at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\tempo.ico" />
    <EmbeddedResource Include="Assets\tempo-about.gif" />
    <!--
      Silero VAD v5.1.2 in whisper.cpp's ggml conversion (885,098 bytes, SHA-256 29940d98…ea2cf,
      huggingface.co/ggml-org/whisper-vad). Run by Utils/SileroVad.cs — NOT by Whisper.net, which only
      has VAD from 1.9.1, the version pinned away from below. MIT (Silero Team; the ggml authors).
    -->
    <EmbeddedResource Include="Assets\ggml-silero-v5.1.2.bin" LogicalName="Tempo.ggml-silero-v5.1.2.bin" />
    <!-- The caption speakers' face detector (round 26): OpenCV Zoo's YuNet 2023mar, MIT, 232,589 bytes,
         SHA-256 8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 (as published on
         huggingface.co/opencv/face_detection_yunet). Run by Utils/FaceAi.cs on Windows' own ML engine. The
         recognizer (SFace, 36.9 MB) is not built in: it is fetched on first use. -->
    <EmbeddedResource Include="Assets\face_detection_yunet_2023mar.onnx" LogicalName="Tempo.face_detection_yunet_2023mar.onnx" />
    <!-- The Apache License 2.0 text (SFace and the ported OpenCV code), shown with About Tempo's licences. -->
    <EmbeddedResource Include="Assets\licences\Apache-2.0.txt" LogicalName="Tempo.Apache-2.0.txt" />
    <!-- Embedded, not copied beside the exe: publish is single-file. -->
    <EmbeddedResource Include="UI\Web\settings.html" />
    <!--
      The uninstaller, carried INSIDE Tempo.exe so an update can refresh the copy sitting in
      the install folder. install.cmd copies uninstall.cmd next to the exe and points both
      UninstallString and QuietUninstallString at it, but an update only ever replaces
      Tempo.exe (UpdateInstaller pulls just that file out of the zip) — so everyone who
      installed from the setup zip kept running the uninstall.cmd they first installed with,
      and none of its fixes ever reached them. Utils/UninstallScriptRefresh.cs compares these
      bytes with that file on startup. LogicalName is fixed so the lookup cannot drift with
      the folder layout.
    -->
    <EmbeddedResource Include="uninstall.cmd" LogicalName="Tempo.uninstall.cmd" />
  </ItemGroup>

  <!--
    Tempo's own Live Captions engine (optional alternative to Windows Live
    Captions). NAudio provides WASAPI loopback capture of the system audio;
    Whisper.net runs the speech-to-text locally and offline. The Whisper *model*
    file is not a package - it's installed beside the app (the installer ships a
    small model, and larger ones can be added later). These restore from NuGet on
    a normal Windows build; they are not available in the offline build sandbox.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!--
      Whisper.net is PINNED at 1.8.1 — the 1.9.1 core was tried on 2026-07-13 and
      showed no benefit (and its Large Turbo run hit the too-slow downgrade, though
      the box was under load). Re-verify with the timed TTS latency tests on a
      QUIET machine before ever bumping.
    -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!--
      GPU inference (Vulkan) is OPT-IN via Settings → Live Captions → "Try GPU
      engine": the default runtime order is forced to CPU-first, and only that
      checkbox puts Vulkan ahead. Version matters ENORMOUSLY here — measured
      2026-07-13 on this NVIDIA box: Vulkan 1.9.1 was so slow the audio buffer
      dropped all but sentence tails, while Vulkan 1.8.1 (this pin) runs LARGE
      TURBO in sustained real time (GPU spikes confirmed via nvidia-smi). Keep the
      runtime version LOCKSTEP with Whisper.net above, keep the option opt-in
      (GPU drivers vary wildly), and keep the automatic switch-back guard in
      OnTempoModelTooSlow. AMD/Intel GPU users get their only possible GPU path
      this way; CPU behaviour is untouched when the box is unticked.
    -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.8.1" />
    <!--
      sherpa-onnx (k2-fsa, Apache-2.0; brings ONNX Runtime, MIT): the engine for NVIDIA's Nemotron streaming speech
      models (Utils/NemotronStreaming.cs, round 35, user-approved 2026-11-17). Nemotron needs 1.13.4 or later to decode
      correctly (an older runtime transcribes badly without failing). Its runtime packages carry every platform's
      native libraries; DropOtherPlatformNatives above leaves all but win-x64 out of the bundle. Its onnxruntime.dll must
      be loaded BEFORE Windows' in-box machine learning brings System32's (NemotronStreaming.Prepare) — the other way
      round, sherpa-onnx bound to System32's ORT 1.17 and crashed (scratchpad nemotron harness, "winml-first" mode).
    -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.1" />
  </ItemGroup>

</Project>
